<Popup x:Class="TextEditingInPreviewPlugin.UI.InPlaceTextEditorOverlay"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       AllowsTransparency="True"
       Placement="Absolute"
       StaysOpen="True"
       Focusable="True">
    <Grid Name="RootContainer" Background="#01000000">
        <!-- 編集枠: 背景ほぼ完全透明（HitTest捕捉用）！アウトラインと四隅マーカーのみ表示し、下のDirect2D文字を100%美しく透過 -->
        <Border Name="EditorBorder"
                BorderBrush="#00A2ED"
                BorderThickness="1.5"
                Background="#01000000"
                CornerRadius="1"
                Padding="0">
            <Grid>
                <!-- 四隅のPremiere風マーカー -->
                <Rectangle Width="5" Height="5" Fill="White" Stroke="#00A2ED" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0"/>
                <Rectangle Width="5" Height="5" Fill="White" Stroke="#00A2ED" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"/>
                <Rectangle Width="5" Height="5" Fill="White" Stroke="#00A2ED" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3"/>
                <Rectangle Width="5" Height="5" Fill="White" Stroke="#00A2ED" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>

                <!--
                     MainRichTextBox:
                     文字は完全透明（Foreground="Transparent"）！
                     下のプレビュー画像・Direct2Dテキストがそのまま見え、文字が二重に重なることは絶対にありません。
                     文字サイズやスタイルに合わせた「半透明ブルーの選択ハイライト」と「キャレット」のみを表示！
                -->
                <RichTextBox Name="MainRichTextBox"
                             Background="Transparent"
                             Foreground="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Margin="0"
                             AcceptsReturn="True"
                             AutoWordSelection="False"
                             VerticalScrollBarVisibility="Hidden"
                             HorizontalScrollBarVisibility="Hidden"
                             IsUndoEnabled="False"
                             IsInactiveSelectionHighlightEnabled="True"
                             CaretBrush="White"
                             SelectionBrush="#8000A2ED"
                             SelectionOpacity="0.65">
                    <RichTextBox.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>
        </Border>
    </Grid>
</Popup>
