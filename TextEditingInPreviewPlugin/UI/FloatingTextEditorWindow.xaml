<Window x:Class="TextEditingInPreviewPlugin.UI.FloatingTextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="460"
        Height="260"
        MinWidth="280"
        MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <!-- 最小限の閉じるボタン（✕） -->
        <Style x:Key="MiniCloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ウィンドウ外枠: YMM4のテーマ背景に完全同期（ControlBrushKey） -->
    <Border Margin="6"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
            BorderThickness="1"
            CornerRadius="3">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="16"/>
                <!-- ドラッグ移動用ミニマルバー -->
                <RowDefinition Height="*"/>
                <!-- YMM4公式 RichTextEditor コントロール -->
                <RowDefinition Height="12"/>
                <!-- リサイズグリップ -->
            </Grid.RowDefinitions>

            <!-- 1. ミニマル・ドラッグバー（テキスト表示なし・掴んで移動可能） -->
            <Border Grid.Row="0"
                    Name="TitleBar"
                    Background="Transparent"
                    Cursor="SizeAll">
                <Grid>
                    <!-- 中央の薄いドラッググリップ線 -->
                    <Rectangle Width="36" Height="2" Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                    <Button Name="CloseButton" Style="{StaticResource MiniCloseBtn}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"/>
                </Grid>
            </Border>

            <!-- 2. YMM4公式 RichTextEditor 配置コンテナ（コントロールのみすっきり表示） -->
            <ContentControl Grid.Row="1"
                            Name="EditorContainer"
                            Margin="2,0,2,0"/>

            <!-- 3. フッター: テキストなし・右下リサイズグリップのみ -->
            <Grid Grid.Row="2">
                <ResizeGrip Name="WindowResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Margin="0,0,1,1"/>
            </Grid>
        </Grid>
    </Border>
</Window>
